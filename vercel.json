{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.ico$|favicon-[0-9]+x[0-9]+\\.png$|apple-touch-icon\\.png$|icon-[0-9]+x[0-9]+\\.png$|og-image\\.jpg$|site\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ]
}
